{
  "name": "saju-app",
  "productName": "사주 분석 지도",
  "version": "0.1.0",
  "description": "사주 분석 지도 (Windows Electron, 이후 iPad PWA)",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:web": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "build": "npm run typecheck && npm run build:web && npm run build:electron",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "pack:win": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "html-to-image": "^1.11.13",
    "lunar-javascript": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.gj.saju-map",
    "productName": "사주 분석 지도",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SajuMap-Setup-${version}.${ext}",
      "shortcutName": "사주 분석 지도"
    },
    "portable": {
      "artifactName": "SajuMap-Portable-${version}.${ext}"
    }
  }
}
